From 9cb58247b93a1cdd5e2ca5ea9e3bdf43cd3a72e0 Mon Sep 17 00:00:00 2001
From: Shane Williams <44717004+KingHavok@users.noreply.github.com>
Date: Tue, 3 Nov 2026 15:15:10 +1100
Subject: [PATCH] Support external authentication providers in front of Home
 Assistant

Keep main-frame authentication-provider navigation inside the WebView so that
OIDC / OAuth 2.0 reverse proxies (Cloudflare Access, Authelia, Authentik, Vouch,
oauth2-proxy) can complete their interactive sign-in inside the app instead of
being ejected to the system browser, where the resulting session cookie never
returns to the app's WebView.

HAWebViewClient's shouldOverrideUrlLoading(WebResourceRequest) now keeps two
kinds of navigation in-WebView: server-initiated http(s) redirects on the
main frame (the proxy challenge and its return redirect), and any main-frame
http(s) navigation made while the WebView is currently on a host other than the
Home Assistant origin (so federated-IdP buttons on a proxy login page are not
ejected mid-flow). Everything else falls through to the existing onUrlIntercepted
path, so user-tapped external links from the HA frontend still open in the system
browser.

The Home Assistant origin is derived from the currentUrlFlow the client is
already constructed with, so no ViewModel wiring is required. Earlier versions of
this change pushed the anchor in from WebViewActivity and then from
FrontendViewModel/ConnectionViewModel; both broke when upstream refactored those
call sites (FrontendScreen migration, then async mTLS + SuspendLazy clients).
Deriving it from currentUrlFlow keeps the whole change in one file.

Known limitation: Google / Microsoft federated sign-in refuses to render in any
embedded WebView (Error 403: disallowed_useragent) by published provider policy;
use a non-federated factor (email OTP, TOTP, WebAuthn) or a self-hosted IdP.

Based on closed upstream PR home-assistant/android#6725.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .../companion/android/util/HAWebViewClient.kt | 42 +++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/app/src/main/kotlin/io/homeassistant/companion/android/util/HAWebViewClient.kt b/app/src/main/kotlin/io/homeassistant/companion/android/util/HAWebViewClient.kt
index 23be2f010..ab4027620 100644
--- a/app/src/main/kotlin/io/homeassistant/companion/android/util/HAWebViewClient.kt
+++ b/app/src/main/kotlin/io/homeassistant/companion/android/util/HAWebViewClient.kt
@@ -13,6 +13,7 @@ import android.webkit.WebResourceRequest
 import android.webkit.WebResourceResponse
 import android.webkit.WebView
 import androidx.annotation.VisibleForTesting
+import androidx.core.net.toUri
 import androidx.webkit.WebViewCompat
 import androidx.webkit.WebViewFeature
 import io.homeassistant.companion.android.common.R as commonR
@@ -308,10 +309,51 @@ class HAWebViewClient internal constructor(
         return true
     }
 
+    /**
+     * Keeps authentication-provider navigation inside the WebView instead of handing it to the host
+     * (which would open it in the system browser).
+     *
+     * When an OIDC / OAuth 2.0 reverse proxy (Cloudflare Access, Authelia, Authentik, Vouch,
+     * oauth2-proxy, ...) sits in front of Home Assistant, it challenges the user on its own domain
+     * before the Home Assistant frontend is ever reached. Treating that as an "external link" breaks
+     * the flow: the sign-in completes in the browser and its session cookie never returns to this
+     * WebView. Two kinds of navigation are therefore followed in-WebView:
+     *
+     *  1. Server-initiated http(s) redirects on the main frame — the proxy's auth challenge and its
+     *     return redirect back to Home Assistant.
+     *  2. Any main-frame http(s) navigation made while the WebView is currently on a host other than
+     *     the Home Assistant origin — so a federated-IdP button on the proxy's own login page does
+     *     not eject the user mid-flow.
+     *
+     * Everything else falls through to [onUrlIntercepted], so user-tapped external links on the
+     * Home Assistant frontend still open in the system browser exactly as before.
+     */
     override fun shouldOverrideUrlLoading(view: WebView?, request: WebResourceRequest?): Boolean {
+        if (isAuthProviderNavigation(view, request)) {
+            Timber.d("Allowing main-frame navigation to load in WebView (auth flow)")
+            return false
+        }
         return request?.url?.let { onUrlIntercepted?.invoke(it, isTLSClientAuthNeeded) } ?: false
     }
 
+    /**
+     * The Home Assistant origin the WebView is anchored to, derived from [currentUrlFlow] (the URL
+     * the app asked the WebView to load). Navigation away from this host is what marks an in-flight
+     * authentication flow.
+     */
+    private fun isAuthProviderNavigation(view: WebView?, request: WebResourceRequest?): Boolean {
+        if (request == null) return false
+        if (!request.isForMainFrame) return false
+        val scheme = request.url?.scheme?.lowercase()
+        if (scheme != "http" && scheme != "https") return false
+
+        if (request.isRedirect) return true
+
+        val anchorHost = currentUrlFlow.value?.toUri()?.host ?: return false
+        val currentHost = view?.url?.toUri()?.host ?: return false
+        return !currentHost.equals(anchorHost, ignoreCase = true)
+    }
+
     private fun formatErrorDetails(context: Context?, code: Int?, description: String?): String {
         return context?.getString(
             commonR.string.connection_error_more_details_description_content,
