@@ -37,9 +40,51 @@ open class TLSWebViewClient(private var keyChainRepository: KeyChainRepository)
     var isCertificateChainValid = false
         @VisibleForTesting set
 
+    /**
+     * Host of the Home Assistant server the WebView is anchored to (e.g. `ha.example.com`).
+     * Set by the frontend/onboarding ViewModels when they choose the server URL to load.
+     *
+     * Used to distinguish user-initiated external link taps from in-flight authentication
+     * flows on third-party domains (Cloudflare Access, Authelia, Authentik, etc.). When null,
+     * only server-initiated redirects are kept in the WebView.
+     */
+    var serverHost: String? = null
+
     private var key: PrivateKey? = null
     private var chain: Array<X509Certificate>? = null
 
+    /**
+     * Keeps authentication-provider navigation inside the WebView instead of handing it to the
+     * system browser. Two cases are followed in-WebView: server-initiated http(s) redirects on the
+     * main frame (the proxy challenge and its return redirect), and any main-frame http(s)
+     * navigation while the WebView is currently on a host other than [serverHost] (so federated-IdP
+     * buttons on a proxy login page don't eject the user mid-flow). Everything else falls through to
+     * the deprecated overload, preserving the existing external-link handling.
+     */
+    @SuppressLint("NewApi")
+    override fun shouldOverrideUrlLoading(view: WebView?, request: WebResourceRequest?): Boolean {
+        if (isAuthProviderNavigation(view, request)) {
+            Timber.d("Allowing main-frame navigation to load in WebView (auth flow)")
+            return false
+        }
+        @Suppress("DEPRECATION")
+        return shouldOverrideUrlLoading(view, request?.url?.toString())
+    }
+
+    @SuppressLint("NewApi")
+    private fun isAuthProviderNavigation(view: WebView?, request: WebResourceRequest?): Boolean {
+        if (request == null) return false
+        if (!request.isForMainFrame) return false
+        val scheme = request.url?.scheme?.lowercase()
+        if (scheme != "http" && scheme != "https") return false
+
+        if (request.isRedirect) return true
+
+        val anchor = serverHost ?: return false
+        val currentHost = view?.url?.toHttpUrlOrNull()?.host ?: return false
+        return !currentHost.equals(anchor, ignoreCase = true)
+    }
+
     private fun getActivity(context: Context?): Activity? {
         if (context == null) {
             return null
